    def feedLedState(self):     return self.override_mgr.feedLedState

    @Property(float, notify=feedChanged)
    def feedPercent(self):      return self.override_mgr.feedPercent

    # toolNumber / toolDia / toolOffset 已迁移至 Status 层
    # QML 直接使用 status.toolInSpindle / status.toolDiameter / status.toolOffsetZ

    @Slot()
    def toggleZInhibit(self):
        print("[Backend] toggleZInhibit called")

    @Slot()
    def autoToolZero(self):
        print("[Backend] autoToolZero called")

    @Slot()
    def rememberPosition(self):
        print("[Backend] rememberPosition called")

    @Slot()
    def returnPosition(self):
        print("[Backend] returnPosition called")

    # spindle / programmedSpindle 已迁移至 Status 层
    # spindleDir 保留（QML 层访问 status.spindleDir 存在兼容问题）

    @Property(int, notify=spindleChanged)
    def spindleDir(self) -> int:
        return self.cnc_status.spindleDir

    @Property(int, notify=spindleChanged)
    def spindlePercent(self):   return self.override_mgr.spindlePercent

    @Property(int, notify=spindleChanged)
    def spindleLedState(self):  return self.override_mgr.spindleLedState

    # machineMode / interpIdle / interpState / machineOn / isTeleop 保留（QML 访问兼容）

    @Property(str, notify=machineChanged)
    def machineMode(self) -> str:
        return self.cnc_status.taskMode

    @Property(bool, notify=machineChanged)
    def machineOn(self) -> bool:
        return self.cnc_status.taskState == "就绪"

    @Property(bool, notify=machineChanged)
    def isTeleop(self) -> bool:
        return self.cnc_status.isTeleop

    @Property(bool, notify=machineChanged)
    def interpIdle(self) -> bool:
        return self.cnc_status.interpIdle

    @Property(int, notify=machineChanged)
    def interpState(self) -> int:
        return self.cnc_status.interpState

    @Property(int, notify=machineChanged)
    def motionType(self) -> int:
        return getattr(self.cnc_status, '_motion_type', 0)

    @Property(str, constant=True)
    def logFilePath(self):
        if not self.cnc_status.log_file:
            return ""
        path = self.cnc_status.log_file.replace('\\', '/')
        if not path.startswith('/'):
            path = '/' + path
        return "file://" + path

    # hasMessage / messageText 已迁移至 Status 层
    # QML 直接使用 status.hasMessage / status.messageText

    @Slot(str)
    def setMachineMode(self, mode: str) -> None:
        if mode == "手动":
            self.cnc_command.setModeManual()
        elif mode == "自动":
            self.cnc_command.setModeAuto()
        elif mode == "MDI":
            self.cnc_command.setModeMDI()
            
    @Slot()
    def toggleTaskMode(self) -> None:
        current_mode = getattr(self.cnc_status, 'taskMode', "未知")
        if current_mode == "手动":
            self.setMachineMode("自动")
        elif current_mode == "自动":
            self.setMachineMode("MDI")
        else:
            self.setMachineMode("手动")

    @Slot(str)
    def submitCommand(self, text: str) -> None:
        self.cnc_command.mdi(text)

    @Property(str, notify=programChanged)
    def modal(self): return self._modal

    @Property(str, notify=programChanged)
    def programName(self):
        import os
        pfile = self.cnc_status.programFile
        if pfile and not pfile.endswith("empty.ngc"):
            return os.path.basename(pfile)
        return self._programName if self._programName else ""
        
    @Property(str, notify=programChanged)
    def programFile(self):
        pfile = self.cnc_status.programFile
        if pfile and not pfile.endswith("empty.ngc"):
            return pfile
        return ""

    @Property(int, notify=lineChanged)
    def lineNumber(self): return self.cnc_status.motionLine

    @Slot(int)
    def requestRunFromLine(self, line: int):
        self.cnc_command.requestRunFromLine(line, is_idle=self.cnc_status.interpIdle)

    @Slot(int, 'QVariantMap')
    def confirmRunFromLine(self, line: int, options: dict):
        if hasattr(self.cnc_command, 'confirmRunFromLineWithOptions'):
            self.cnc_command.confirmRunFromLineWithOptions(line, options, is_idle=self.cnc_status.interpIdle)
        else:
            self.cnc_command.confirmRunFromLine(line, is_idle=self.cnc_status.interpIdle)

    @Property(str, constant=True)
    def userName(self): return self._userName

    @Property(str, notify=timeChanged)
    def dateStr(self): return self.runtime_tracker.dateStr

    @Property(str, notify=timeChanged)
    def timeStr(self): return self.runtime_tracker.timeStr

    # ---- JOG 属性（委托 JogController） ----
    @Property(float, notify=machineChanged)
    def jogPercent(self):       return self.jog_controller.jogPercent

    @Property(int, notify=machineChanged)
    def jogMode(self):          return self.jog_controller.jogMode

    @Slot(int)
    def setJogMode(self, mode: int):
        self.jog_controller.setMode(mode)

    @Property(int, notify=machineChanged)
    def jogStepIndex(self):     return self.jog_controller.jogStepIndex

    @Property(float, notify=machineChanged)
    def currentJogStep(self):   return self.jog_controller.currentJogStep

    @Slot(int)
    def setJogStepIndex(self, index: int):
        self.jog_controller.setStepIndex(index)

    # ---- 工件偏置（委托 Status） ----
    @Property(float, notify=systemsChanged)
    def workOffsetX(self): return self.cnc_status.workOffsetX
    @Property(float, notify=systemsChanged)
    def workOffsetY(self): return self.cnc_status.workOffsetY
    @Property(float, notify=systemsChanged)
    def workOffsetZ(self): return self.cnc_status.workOffsetZ

